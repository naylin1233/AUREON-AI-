# Local API
HOST=127.0.0.1
PORT=8787
AUREON_DATA_DIR=./storage/data
AUREON_MAX_UPLOAD_MB=1024

# Single-owner browser login. Leave unset for local loopback-only development.
# Public interface (HOST=0.0.0.0) refuses to start unless both values are configured.
# Password must be at least 12 characters; session secret must be at least 32 random bytes.
# Never commit real values or paste them into chat.
# AUREON_ADMIN_PASSWORD=
# AUREON_SESSION_SECRET=

# Gemini AI recap script (server-side only; fixed to Gemini 3.8 Flash).
# Use an account/key that remains on the Free Tier; this app cannot inspect provider billing settings.
# Do not enable paid billing without explicit approval.
# GEMINI_API_KEY=

# Optional free text-generation fallback. This is pinned to OpenRouter's free-only router.
# Free models have provider-specific limits; no paid model is selected by this app.
# OPENROUTER_API_KEY=

# Optional metered speech-to-text fallback. OFF unless explicitly enabled.
# Groq transcription is usage-metered; enabling it can incur provider charges.
# Only enable after an adult account owner has reviewed the provider terms and costs.
# GROQ_API_KEY=
# GROQ_TRANSCRIPTION_ENABLED=false

# YouTube Data API v3 reference discovery (metadata only).
# Keep this key private; restrict it to YouTube Data API v3 in Google Cloud.
# YOUTUBE_API_KEY=
# Optional: up to four semicolon-separated search terms.
# YOUTUBE_REFERENCE_QUERIES=popular anime recap;foreign movie recap;3D animation movie recap;Chinese donghua recap

# Myanmar TTS and social OAuth providers remain unset.

# Optional Burmese Neural TTS (Azure Speech F0)
# Create/configure an Azure Speech resource with adult/guardian assistance if required.
# Keep the key only in this server-side environment. Never put it in frontend variables.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
