# Local API
HOST=127.0.0.1
PORT=8787
AUREON_DATA_DIR=./storage/data
AUREON_MAX_UPLOAD_MB=1024

# Optional: set a long random token when exposing the API beyond localhost.
# Never commit a real token or provider credentials.
# AUREON_API_TOKEN=

# Gemini AI recap script (server-side only; Free-tier-first).
# GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Myanmar TTS and social OAuth providers remain unset.

# Optional Burmese Neural TTS (Azure Speech F0)
# Create/configure an Azure Speech resource with adult/guardian assistance if required.
# Keep the key only in this server-side environment. Never put it in frontend variables.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
